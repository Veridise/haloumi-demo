+#[cfg(feature = "extraction")]
+pub fn extract_assign_message_block(
+    extractor: &picus::extractor::extractor::Extractor,
+) -> picus::extractor::Output {
+    use midnight_curves::Fq as F;
+    use midnight_proofs::{
+        circuit::{Cell, RegionIndex},
+        plonk::{Advice, Column, ConstraintSystem, Error, Expression, Fixed},
+    };
+    use picus::{
+        core::circuit::{AbstractCircuitIO, NoChipArgs},
+        extractor::circuit::{AbstractCircuit, Function},
+    };
+
+    struct Circuit;
+
+    impl AbstractCircuitIO for Circuit {
+        type Chip = PackedChip<F>;
+        type Input = [<PackedChip<F> as Keccackf1600Instructions<F>>::AssignedByte; 136];
+        type Output = AbsorbedBlock<F>;
+        type Config = PackedConfig;
+        type ConfigCols = (
+            Column<Fixed>,
+            [Column<Advice>; PACKED_ADVICE_COLS],
+            [Column<Fixed>; PACKED_FIXED_COLS],
+        );
+    }
+
+    impl AbstractCircuit<F> for Circuit {
+        type Error = Error;
+        type Expression = Expression<F>;
+        type Cell = Cell;
+        type RegionIndex = RegionIndex;
+
+        fn synthesize<L>(
+            &self,
+            chip: &Self::Chip,
+            layouter: &mut picus::core::layouter::LayoutAdaptor<L>,
+            block: Self::Input,
+            _: &mut picus::ir::inject::InjectedIR<RegionIndex, Self::Expression>,
+        ) -> Result<Self::Output, Self::Error>
+        where
+            L: picus::core::layouter::Layouter<F, Self::Error>
+                + picus::core::groups::RegionsGroupHooks<F, Self::Cell, Error = Self::Error>,
+        {
+            chip.assign_message_block(layouter, &block.map(|byte| byte.value().cloned()))
+        }
+    }
+
+    impl NoChipArgs for Circuit {}
+
+    let circuit = extractor
+        .make_circuit::<F, _, Function, midnight_proofs::ExtractionSupport, ConstraintSystem<F>>(
+            Circuit,
+        );
+    let lookups = crate::lookup_callbacks::sha3_lookup_callbacks();
+    let gates = crate::gate_callbacks::sha3_gate_callbacks();
+    Ok(extractor.extract_circuit_with_callbacks(circuit, Some(&lookups), Some(&gates))?)
+}
