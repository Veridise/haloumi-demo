diff --git a/.haloumi/cfg.toml b/.haloumi/cfg.toml
new file mode 100644
index 0000000..1188494
--- /dev/null
+++ b/.haloumi/cfg.toml
@@ -0,0 +1,19 @@
+[extractor]
+preludes = ["spread"]
+
+[extractor.dependency]
+git = "https://github.com/project-llzk/haloumi"
+branch = "shankara/gate-callbacks-cli2"
+package = "haloumi-extractor-runner"
+features = ["llzk-backend"]
+
+[target]
+features = ["extraction"]
+
+[backends.picus]
+enabled = true
+optimize = true
+
+[backends.llzk]
+enabled = true
+field = "bls12"
diff --git a/.haloumi/specs/midnight-proofs.toml b/.haloumi/specs/midnight-proofs.toml
