+#[cfg(feature = "extraction")]
+mod gate_callbacks {
+    //! Gate callbacks used by the SHA-3 extraction harnesses.
+    //!
+    //! The bootstrap gate `acc[r+1] = 2·acc[r] + part[r+1]` splits a noisy spread word into
+    //! clean parts. Each digit of `part` is 0 or 1 (lookup-checked limbs) and each digit of `acc`
+    //! is at most 3, so every digit `2·d_acc + d_part` stays below 8 and decodes uniquely. Range
+    //! bounds cannot express that, so on every enabled row we state it as an axiom:
+    //! `det(acc[r+1]) → det(acc[r]) ∧ det(part[r+1])`.
+
+    use std::{borrow::Cow, cell::Cell, collections::BTreeMap};
+
+    use ff::Field;
+    use midnight_curves::Fq;
+    use midnight_proofs::plonk::{AdviceQuery, Expression};
+    use picus::{
+        core::info_traits::CreateQuery as _,
+        ir::{CmpOp, expr::IRBexpr, meta::HasMeta as _, stmt::IRStmt},
+        ir_gen::gates::{
+            GateScope,
+            callbacks::GateCallbacks,
+            rewrite::{GateRewritePattern, MatchAndRewriteResult},
+        },
+    };
+
+    const BOOTSTRAP_GATE: &str = "bootstrap constraint";
+
+    #[derive(Debug, Default)]
+    pub(crate) struct Sha3GateCallbacks {
+        bootstrap: BootstrapAxioms,
+    }
+
+    pub(crate) fn sha3_gate_callbacks() -> Sha3GateCallbacks {
+        Sha3GateCallbacks::default()
+    }
+
+    impl GateCallbacks<Fq, Expression<Fq>> for Sha3GateCallbacks {
+        fn patterns(&self) -> Vec<&dyn GateRewritePattern<Fq, Expression<Fq>>> {
+            vec![&self.bootstrap]
+        }
+    }
+
+    /// Emits the bootstrap gate's constraint and its determinism axiom on every enabled row.
+    #[derive(Debug, Default)]
+    struct BootstrapAxioms;
+
+    impl GateRewritePattern<Fq, Expression<Fq>> for BootstrapAxioms {
+        fn match_and_rewrite<'syn>(
+            &self,
+            gate: GateScope<'syn, '_, Fq, Expression<Fq>>,
+        ) -> MatchAndRewriteResult<'syn, Expression<Fq>> {
+            if gate.gate_name() != BOOTSTRAP_GATE {
+                return Ok(None);
+            }
+            let [poly] = gate.polynomials() else {
+                return Err(Error::Polynomials.into());
+            };
+            let cells = BootstrapCells::read(poly)?;
+            let rows: Vec<_> = gate.enabled_rows(poly).collect();
+            Ok(Some(
+                rows.into_iter()
+                    .flat_map(|row| {
+                        // A matching pattern replaces the fallback lowering, so keep the gate.
+                        let constraint = IRStmt::constraint(
+                            CmpOp::Eq,
+                            Cow::Borrowed(poly),
+                            Cow::Owned(Expression::Constant(Fq::ZERO)),
+                        );
+                        let axiom = IRStmt::assert(
+                            IRBexpr::det(Cow::Owned(cells.acc_next.clone())).implies(
+                                IRBexpr::det(Cow::Owned(cells.acc.clone()))
+                                    & IRBexpr::det(Cow::Owned(cells.part_next.clone())),
+                            ),
+                        );
+                        [constraint, axiom].into_iter().map(move |mut stmt| {
+                            stmt.meta_mut().at_row(row);
+                            stmt.map(&mut |e| (row, e))
+                        })
+                    })
+                    .collect(),
+            ))
+        }
+    }
+
+    /// The cells of `acc_next - 2·acc - part_next`, read off the gate polynomial.
+    struct BootstrapCells {
+        acc: Expression<Fq>,
+        acc_next: Expression<Fq>,
+        part_next: Expression<Fq>,
+    }
+
+    impl BootstrapCells {
+        /// Accepts exactly `q · (acc_next - 2·acc - part_next)` with `acc`, `acc_next` in one
+        /// advice column at rotations 0 and 1 and `part_next` in another at rotation 1.
+        fn read(poly: &Expression<Fq>) -> Result<Self, Error> {
+            let selectors = Cell::new(0);
+            let (terms, constant) = linear(poly, &selectors).ok_or(Error::Shape)?;
+            let terms: Vec<_> = terms.into_iter().filter(|(_, c)| *c != Fq::ZERO).collect();
+            if selectors.get() != 1 || constant != Fq::ZERO || terms.len() != 3 {
+                return Err(Error::Shape);
+            }
+            let find = |coeff: Fq| {
+                terms
+                    .iter()
+                    .find(|(_, c)| *c == coeff)
+                    .map(|(cell, _)| *cell)
+                    .ok_or(Error::Shape)
+            };
+            let acc_next = find(Fq::ONE)?;
+            let acc = find(-Fq::from(2))?;
+            let part_next = find(-Fq::ONE)?;
+            if acc_next != (acc.0, 1) || acc.1 != 0 || part_next.1 != 1 || part_next.0 == acc.0 {
+                return Err(Error::Shape);
+            }
+            let query = |(column, rotation): (usize, i32)| AdviceQuery::query_expr(column, rotation);
+            Ok(Self {
+                acc: query(acc),
+                acc_next: query(acc_next),
+                part_next: query(part_next),
+            })
+        }
+    }
+
+    /// Advice cells `(column, rotation)` with their coefficients, plus a constant term.
+    type Linear = (BTreeMap<(usize, i32), Fq>, Fq);
+
+    /// Reads `poly` as a linear form over advice cells, treating selectors as 1 and counting them.
+    /// Returns `None` for anything nonlinear or for fixed, instance or challenge queries.
+    fn linear(poly: &Expression<Fq>, selectors: &Cell<usize>) -> Option<Linear> {
+        fn scale((terms, constant): Linear, by: Fq) -> Linear {
+            (terms.into_iter().map(|(k, c)| (k, c * by)).collect(), constant * by)
+        }
+        poly.evaluate(
+            &|c| Some((BTreeMap::new(), c)),
+            &|_| {
+                selectors.set(selectors.get() + 1);
+                Some((BTreeMap::new(), Fq::ONE))
+            },
+            &|_| None,
+            &|q: AdviceQuery| {
+                let cell = (q.column_index(), q.rotation().0);
+                Some((BTreeMap::from([(cell, Fq::ONE)]), Fq::ZERO))
+            },
+            &|_| None,
+            &|_| None,
+            &|a| a.map(|a| scale(a, -Fq::ONE)),
+            &|a, b| {
+                let ((mut terms, c), (other, d)) = (a?, b?);
+                for (k, v) in other {
+                    *terms.entry(k).or_insert(Fq::ZERO) += v;
+                }
+                Some((terms, c + d))
+            },
+            &|a, b| match (a?, b?) {
+                ((ta, ca), b) if ta.is_empty() => Some(scale(b, ca)),
+                (a, (tb, cb)) if tb.is_empty() => Some(scale(a, cb)),
+                _ => None,
+            },
+            &|a, s| a.map(|a| scale(a, s)),
+        )
+    }
+
+    #[derive(Debug)]
+    enum Error {
+        Polynomials,
+        Shape,
+    }
+
+    impl std::fmt::Display for Error {
+        fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+            match self {
+                Self::Polynomials => write!(f, "{BOOTSTRAP_GATE}: expected exactly one polynomial"),
+                Self::Shape => write!(
+                    f,
+                    "{BOOTSTRAP_GATE}: expected q * (acc_next - 2 * acc - part_next)"
+                ),
+            }
+        }
+    }
+
+    impl std::error::Error for Error {}
+}
